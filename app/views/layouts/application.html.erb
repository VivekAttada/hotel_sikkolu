<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hotel Sikkolu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hotel Sikkolu">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="hotel-sikkolu-body <%= 'hs-auth-body' if devise_controller? %>">
    <% unless devise_controller? %>
      <nav class="navbar navbar-expand-lg hs-navbar shadow-sm">
        <div class="container">
          <a class="hs-navbar-brand" href="<%= root_path %>">
            <%= image_tag "hotel_sikkolu_logo.png", alt: "Hotel Sikkolu Logo", class: "hs-logo" %>
            <span class="hs-brand-text">
              <span class="hs-brand-sub">Hotel</span>
              <span class="hs-brand-name">Sikkolu</span>
            </span>
          </a>
          <div class="d-flex align-items-center gap-3 ms-auto">
            <span class="navbar-text hs-navbar-tagline d-none d-md-inline">
              Daily grocery, checklist &amp; inventory management
            </span>
            <% if user_signed_in? %>
              <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-hs-outline btn-sm hs-action-btn" %>
            <% end %>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="<%= devise_controller? ? '' : 'container-fluid container-lg px-3 px-md-4 py-3 py-md-4' %>">
      <% if notice.present? || alert.present? %>
        <div class="hs-flash-stack <%= 'mx-3 mt-3' if devise_controller? %>" data-controller="flash" data-turbo-temporary>
          <% if notice.present? %>
            <div class="alert alert-success alert-dismissible fade show hs-flash" role="alert">
              <%= notice %>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <% if alert.present? %>
            <div class="alert alert-danger alert-dismissible fade show hs-flash" role="alert">
              <%= alert %>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <% unless devise_controller? %>
      <footer class="text-center hs-footer">
        <small>&copy; <%= Date.current.year %> Hotel Sikkolu</small>
      </footer>
    <% end %>
  </body>
</html>
