<% content_for :title, "KOT — Table #{@bill.dining_table.name} — Hotel Sikkolu" %>

<style>
  .hs-kot {
    max-width: 380px;
    margin: 0 auto;
    font-family: "Courier New", Courier, monospace;
  }
  .hs-kot h1 {
    margin: 0;
    font-size: 1.5rem;
    text-align: center;
    letter-spacing: 0.08em;
  }
  .hs-kot .subtitle {
    margin: 0.15rem 0 0.85rem;
    text-align: center;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .hs-kot .badge {
    display: inline-block;
    margin: 0 auto 0.75rem;
    padding: 0.15rem 0.5rem;
    border: 2px solid #111;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .hs-kot-center { text-align: center; }
  .hs-kot-meta {
    margin-bottom: 0.85rem;
    font-size: 0.95rem;
    line-height: 1.45;
    border-top: 1px dashed #111;
    border-bottom: 1px dashed #111;
    padding: 0.55rem 0;
  }
  .hs-kot table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.05rem;
  }
  .hs-kot th,
  .hs-kot td {
    padding: 0.45rem 0.2rem;
    border-bottom: 1px solid #ccc;
    text-align: left;
    vertical-align: top;
  }
  .hs-kot th {
    border-bottom: 2px solid #111;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  .hs-kot .qty {
    text-align: right;
    font-weight: 700;
    font-size: 1.2rem;
    white-space: nowrap;
    width: 3.5rem;
  }
  .hs-kot .item-name {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .hs-kot .item-cat {
    display: block;
    font-size: 0.75rem;
    font-weight: 400;
    margin-top: 0.1rem;
  }
  .hs-kot-footer {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.85rem;
  }
  @media print {
    .hs-kot { max-width: none; }
  }
</style>

<div class="hs-kot">
  <h1>HOTEL SIKKOLU</h1>
  <p class="subtitle">KITCHEN ORDER TICKET</p>
  <div class="hs-kot-center">
    <span class="badge"><%= @kot_reprint ? "REPRINT — FULL ORDER" : "NEW KOT" %></span>
  </div>

  <div class="hs-kot-meta">
    <div><strong>TABLE:</strong> <%= @bill.dining_table.name %></div>
    <div><strong>Bill:</strong> <%= @bill.bill_number %></div>
    <div><strong>Time:</strong> <%= Time.current.strftime("%d %b %Y, %I:%M %p") %></div>
    <div><strong>Items:</strong> <%= @kot_rows.sum { |row| row[:quantity] } %></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Item</th>
        <th class="qty">Qty</th>
      </tr>
    </thead>
    <tbody>
      <% @kot_rows.each do |row| %>
        <tr>
          <td>
            <span class="item-name"><%= row[:name] %></span>
            <% if row[:category].present? %>
              <span class="item-cat"><%= row[:category] %></span>
            <% end %>
          </td>
          <td class="qty"><%= row[:quantity] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p class="hs-kot-footer">— Send to kitchen —</p>
</div>
