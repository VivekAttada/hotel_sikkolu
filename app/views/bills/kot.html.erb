<% content_for :title, "KOT #{@kot_number} — Table #{@bill.dining_table.name} — Hotel Sikkolu" %>

<style>
  .hs-kot {
    width: 100%;
    margin: 0;
    font-family: "Courier New", Courier, monospace;
    font-size: 11px;
    line-height: 1.25;
  }
  .hs-kot h1 {
    margin: 0;
    font-size: 14px;
    text-align: center;
    letter-spacing: 0.06em;
  }
  .hs-kot .subtitle {
    margin: 2px 0 6px;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
  }
  .hs-kot .badge {
    display: inline-block;
    margin: 0 auto 6px;
    padding: 1px 6px;
    border: 1px solid #111;
    font-size: 10px;
    font-weight: 700;
  }
  .hs-kot-center { text-align: center; }
  .hs-kot-meta {
    margin-bottom: 6px;
    font-size: 10px;
    line-height: 1.3;
    border-top: 1px dashed #111;
    border-bottom: 1px dashed #111;
    padding: 4px 0;
  }
  .hs-kot table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
  }
  .hs-kot th,
  .hs-kot td {
    padding: 3px 2px;
    border-bottom: 1px solid #ccc;
    text-align: left;
    vertical-align: top;
  }
  .hs-kot th {
    border-bottom: 1px solid #111;
    font-size: 9px;
    text-transform: uppercase;
  }
  .hs-kot .qty {
    text-align: right;
    font-weight: 700;
    font-size: 12px;
    white-space: nowrap;
    width: 2.2rem;
  }
  .hs-kot .item-name {
    font-weight: 700;
    font-size: 11px;
  }
  .hs-kot .item-cat {
    display: block;
    font-size: 9px;
    font-weight: 400;
    margin-top: 1px;
  }
  .hs-kot-footer {
    margin: 6px 0 0;
    text-align: center;
    font-size: 9px;
  }
</style>

<div class="hs-kot">
  <h1>HOTEL SIKKOLU</h1>
  <p class="subtitle">KITCHEN ORDER TICKET</p>
  <div class="hs-kot-center">
    <span class="badge"><%= @kot_additional ? "ADDITIONAL KOT — NEW ITEMS ONLY" : "NEW KOT" %></span>
  </div>
  <p class="subtitle">KOT No: <%= @kot_number %></p>

  <div class="hs-kot-meta">
    <div><strong><%= @bill.dining_table.takeaway? ? "TYPE" : "TABLE" %>:</strong> <%= @bill.dining_table.display_name %></div>
    <div><strong>Bill No:</strong> <%= @bill.bill_number %></div>
    <div><strong>Time:</strong> <%= Time.current.strftime("%d %b %Y, %I:%M %p") %></div>
    <div><strong>Items:</strong> <%= @kot_rows.sum { |row| row[:quantity] } %></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Item</th>
        <th class="qty">Qty</th>
      </tr>
    </thead>
    <tbody>
      <% @kot_rows.each do |row| %>
        <tr>
          <td>
            <span class="item-name"><%= row[:name] %></span>
            <% if row[:note].present? %>
              <span class="item-cat">Note: <%= row[:note] %></span>
            <% end %>
            <% if row[:category].present? %>
              <span class="item-cat"><%= row[:category] %></span>
            <% end %>
          </td>
          <td class="qty"><%= row[:quantity] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p class="hs-kot-footer"><%= @kot_additional ? "— Additional items only. Do not recook previous KOT. —" : "— Send to kitchen —" %></p>
</div>
