<div class="hs-card">
  <div class="hs-card-header">
    <div class="hs-toolbar">
      <div class="hs-toolbar-title">
        <h5>Table <%= @dining_table.name %></h5>
        <small>
          Bill <%= @bill.bill_number %><% if @bill.latest_kot_number %> · KOT <%= @bill.latest_kot_number %><% end %> ·
          <% if @bill.active? %>
            <span class="text-hs-gold">Active</span>
          <% elsif @bill.due? %>
            <span class="text-danger">Due ₹ <%= number_with_precision(@bill.balance_due, precision: 2) %></span>
          <% else %>
            <%= @bill.status_label %><%= " · #{@bill.payment_method_label}" if @bill.payment_method.present? %>
          <% end %>
        </small>
      </div>
      <div class="hs-toolbar-actions">
        <%= link_to bills_path, class: "btn btn-hs-outline btn-sm hs-action-btn" do %>
          <i class="bi bi-arrow-left"></i>
          <span>All tables</span>
        <% end %>
        <% if @bill.active? && @bill.bill_line_items.empty? && @dining_table.can_split? %>
          <%= button_to split_dining_table_path(@dining_table, bill_date: Date.current),
                method: :post,
                class: "btn btn-hs-gold btn-sm hs-action-btn",
                form: { data: { turbo_confirm: "Split #{@dining_table.name} into two orders (#{@dining_table.name}A and #{@dining_table.name}B)?" } } do %>
            <i class="bi bi-layout-split"></i>
            <span>Split</span>
          <% end %>
        <% end %>
        <% if @bill.paid? && (current_user.admin? || current_user.manager? || @bill.paid_by_id == current_user.id || @bill.opened_by_id == current_user.id) %>
          <%= link_to bill_pdf_path(@bill), class: "btn btn-hs-gold btn-sm hs-action-btn", target: "_blank", rel: "noopener", data: { turbo: false } do %>
            <i class="bi bi-file-earmark-pdf"></i>
            <span>Download PDF</span>
          <% end %>
          <%= link_to bill_print_path(@bill), class: "btn btn-hs-outline btn-sm hs-action-btn", target: "_blank", rel: "noopener", data: { turbo: false } do %>
            <i class="bi bi-printer"></i>
            <span>Print</span>
          <% end %>
        <% end %>
        <% if @bill.active? %>
          <%= button_to delete_bill_path(@bill), method: :delete, class: "btn btn-outline-danger btn-sm hs-action-btn", params: { cancel_reason: @bill.kot_sent? ? "Cancelled after KOT" : nil }, form: { data: { turbo_confirm: @bill.kot_sent? ? "KOT already went to kitchen. Manager/admin only. Cancel this bill?" : "Cancel this empty or unpaid bill?" } } do %>
            <i class="bi bi-trash"></i>
            <span>Cancel bill</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="hs-card-body">
    <div class="row g-4">
      <div class="col-lg-7">
        <h6 class="text-hs-gold mb-3">Menu</h6>
        <% if @bill.open_on_table? %>
          <% if @menu_categories.any? %>
            <%= render "bills/menu",
                  categories: @menu_categories,
                  items_by_category: @menu_items_by_category,
                  selected_category: @selected_menu_category,
                  category_path: ->(category) { bill_path(@dining_table, menu_category: category) },
                  add_path: add_bill_item_path(@dining_table) %>
          <% else %>
            <p class="text-hs-muted">No menu items available.</p>
          <% end %>
        <% else %>
          <p class="text-hs-muted">This bill is closed. Menu is locked.</p>
        <% end %>
      </div>

      <div class="col-lg-5">
        <h6 class="text-hs-gold mb-3">Current order</h6>
        <% if @line_items.any? %>
          <div class="table-responsive mb-3">
            <table class="table hs-table align-middle">
              <thead>
                <tr>
                  <th>Item</th>
                  <th>Qty / Note</th>
                  <th>Amount</th>
                  <% if @bill.open_on_table? %><th></th><% end %>
                </tr>
              </thead>
              <tbody>
                <% @line_items.each do |line| %>
                  <tr>
                    <td>
                      <div><%= line.item_name %></div>
                      <small class="text-hs-muted">₹ <%= number_with_precision(line.unit_price, precision: 2) %> each</small>
                      <% if line.kot_sent_quantity.to_i.positive? && @bill.open_on_table? %>
                        <small class="text-hs-muted d-block">KOT sent × <%= line.kot_sent_quantity %><%= " · new × #{line.pending_kot_quantity}" if line.kot_pending? %></small>
                      <% end %>
                      <% if line.note.present? && !@bill.open_on_table? %>
                        <small class="hs-line-note-text d-block"><%= line.note %></small>
                      <% end %>
                    </td>
                    <td>
                      <% if @bill.open_on_table? %>
                        <%= render "bills/order_line_controls", bill: @bill, line: line, menu_category: @selected_menu_category %>
                      <% else %>
                        <%= line.quantity %>
                      <% end %>
                    </td>
                    <td>₹ <%= number_with_precision(line.line_total, precision: 2) %></td>
                    <% if @bill.open_on_table? %>
                      <td class="text-end">
                        <%= button_to "×",
                              remove_bill_item_path(@bill, line),
                              method: :delete,
                              params: { menu_category: @selected_menu_category },
                              class: "btn btn-outline-danger btn-sm",
                              form: { data: { turbo_confirm: "Remove #{line.item_name}?" } } %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="mb-3">
            <%= render "bills/totals", bill: @bill %>
          </div>

          <% if @bill_removals.any? %>
            <div class="hs-bill-removals mb-3">
              <h6 class="text-danger mb-2">Removed after KOT</h6>
              <ul class="hs-settle-removal-list mb-0">
                <% @bill_removals.each do |removal| %>
                  <li>
                    <span><%= removal.item_name %> × <%= removal.quantity %></span>
                    <span>₹ <%= number_with_precision(removal.line_total, precision: 2) %></span>
                  </li>
                <% end %>
              </ul>
              <% if @bill_removals.any? { |r| r.reason.present? } %>
                <p class="hs-removal-reason mt-2 mb-0">
                  <strong>Reason:</strong>
                  <%= @bill_removals.map(&:reason).compact_blank.uniq.join(" / ") %>
                </p>
              <% end %>
            </div>
          <% end %>

            <%= render "bills/bill_checkout", bill: @bill, modal_id: "settleBillModal", title: "Settle and Save" %>

            <% if @bill.active? %>
              <%= form_with url: delete_bill_path(@bill), method: :delete, class: "mt-2" do %>
                <% if @bill.kot_sent? %>
                  <%= text_field_tag :cancel_reason, nil, class: "form-control form-control-sm mb-2", required: true, placeholder: "Reason to cancel after KOT" %>
                <% end %>
                <%= submit_tag "Cancel bill", class: "btn btn-outline-danger w-100", data: { turbo_confirm: "Cancel bill #{@bill.bill_number}?" } %>
              <% end %>
            <% end %>
        <% else %>
          <p class="text-hs-muted mb-0">No items yet. Add food from the menu.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
