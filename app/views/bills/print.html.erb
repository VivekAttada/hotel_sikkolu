<% content_for :title, "Bill #{@bill.bill_number} — Hotel Sikkolu" %>

<style>
  .hs-print-bill {
    width: 100%;
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    color: #000;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .hs-print-bill h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 900;
    text-align: center;
    letter-spacing: 0.03em;
    color: #000;
  }
  .hs-print-bill .subtitle {
    margin: 4px 0 8px;
    text-align: center;
    font-size: 16px;
    font-weight: 800;
    color: #000;
  }
  .hs-print-gstin {
    margin: 0 0 6px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: #000;
  }
  .hs-print-meta {
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.45;
    color: #000;
    border-top: 2px solid #000;
    border-bottom: 2px solid #000;
    padding: 6px 0;
  }
  .hs-print-bill table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    font-weight: 700;
    color: #000;
  }
  .hs-print-bill th,
  .hs-print-bill td {
    padding: 6px 2px;
    border-bottom: 2px solid #000;
    text-align: left;
    color: #000;
    font-weight: 700;
  }
  .hs-print-bill th {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .hs-print-bill .num {
    text-align: right;
    white-space: nowrap;
  }
  .hs-print-bill tfoot td {
    border-bottom: none;
    padding-top: 6px;
  }
  .hs-print-bill tfoot tr.hs-print-sub td {
    border-top: 2px solid #000;
    font-weight: 700;
    font-size: 15px;
  }
  .hs-print-bill tfoot tr.hs-print-grand td {
    border-top: 3px solid #000;
    font-weight: 900;
    padding-top: 8px;
    font-size: 18px;
  }
  .hs-print-removals {
    margin-top: 8px;
    color: #000;
  }
  .hs-print-removals h2 {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 800;
    color: #000;
  }
  .hs-print-removals table th,
  .hs-print-removals table td {
    border-bottom: 2px solid #000;
    color: #000;
  }
  .hs-print-removal-reason {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 700;
    color: #000;
  }
  .hs-print-thanks {
    margin: 12px 0 0;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: #000;
  }
</style>

<div class="hs-print-bill">
  <h1>HOTEL SIKKOLU</h1>
  <p class="hs-print-gstin"><strong>GSTIN:</strong> <%= Bill::GSTIN %></p>
  <p class="subtitle"><%= @bill.paid? ? "Bill Receipt" : "Bill Receipt — Unpaid" %></p>

  <div class="hs-print-meta">
    <div><strong>Bill No:</strong> <%= @bill.bill_number %></div>
    <% if @bill.dining_table.takeaway? %>
      <div><strong>Type:</strong> Take Away</div>
    <% else %>
      <div><strong>Table:</strong> <%= @bill.dining_table.name %></div>
    <% end %>
    <div><strong>Opened:</strong> <%= @bill.opened_at.strftime("%d %b %Y, %I:%M %p") %></div>
    <div><strong>Paid:</strong> <%= @bill.paid_at&.strftime("%d %b %Y, %I:%M %p") || "Not settled" %></div>
    <% if @bill.guest_name.present? || @bill.guest_phone.present? %>
      <div><strong>Guest:</strong> <%= [ @bill.guest_name, @bill.guest_phone ].compact.join(" · ") %></div>
    <% end %>
    <% if @bill.cashier_label.present? %>
      <div><strong>Cashier:</strong> <%= @bill.cashier_label %></div>
    <% end %>
  </div>

  <table>
    <thead>
      <tr>
        <th>Item</th>
        <th class="num">Qty</th>
        <th class="num">Rate</th>
        <th class="num">Amt</th>
      </tr>
    </thead>
    <tbody>
      <% @line_items.each do |line| %>
        <tr>
          <td>
            <%= line.item_name %>
            <% if line.note.present? %>
              <div style="font-size: 13px; font-weight: 700;">Note: <%= line.note %></div>
            <% end %>
          </td>
          <td class="num"><%= line.quantity %></td>
          <td class="num"><%= number_with_precision(line.unit_price, precision: 2) %></td>
          <td class="num"><%= number_with_precision(line.line_total, precision: 2) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="hs-print-sub">
        <td colspan="3" class="num">Total</td>
        <td class="num">₹ <%= number_with_precision(@bill.subtotal, precision: 2) %></td>
      </tr>
      <% if @bill.discount_amount.to_d.positive? || @bill.complementary? %>
        <tr class="hs-print-sub">
          <td colspan="3" class="num">Discount<%= @bill.discount_percent.to_d.positive? ? " #{number_with_precision(@bill.discount_percent, precision: 1).sub(/\.0$/, '')}%" : "" %><%= " (NC)" if @bill.complementary? %></td>
          <td class="num">− ₹ <%= number_with_precision(@bill.discount_amount, precision: 2) %></td>
        </tr>
      <% end %>
      <tr class="hs-print-sub">
        <td colspan="3" class="num">CGST <%= Bill::CGST_PERCENT %>%</td>
        <td class="num">₹ <%= number_with_precision(@bill.cgst_amount, precision: 2) %></td>
      </tr>
      <tr class="hs-print-sub">
        <td colspan="3" class="num">SGST <%= Bill::SGST_PERCENT %>%</td>
        <td class="num">₹ <%= number_with_precision(@bill.sgst_amount, precision: 2) %></td>
      </tr>
      <tr class="hs-print-grand">
        <td colspan="3" class="num">GRAND TOTAL</td>
        <td class="num">₹ <%= number_with_precision(@bill.total, precision: 2) %></td>
      </tr>
    </tfoot>
  </table>

  <p class="hs-print-thanks">Thank you for dining at Hotel Sikkolu!</p>
</div>
