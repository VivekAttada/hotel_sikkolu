<% content_for :title, "Bill #{@bill.bill_number} — Hotel Sikkolu" %>

<style>
  .hs-print-bill {
    max-width: 720px;
    margin: 0 auto;
  }
  .hs-print-bill h1 {
    margin: 0 0 0.25rem;
    font-size: 1.75rem;
    text-align: center;
    letter-spacing: 0.04em;
  }
  .hs-print-bill .subtitle {
    margin: 0 0 1.25rem;
    text-align: center;
    font-size: 1rem;
  }
  .hs-print-meta {
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .hs-print-bill table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .hs-print-bill th,
  .hs-print-bill td {
    padding: 0.55rem 0.4rem;
    border-bottom: 1px solid #ccc;
    text-align: left;
  }
  .hs-print-bill th {
    border-bottom: 2px solid #111;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hs-print-bill .num {
    text-align: right;
    white-space: nowrap;
  }
  .hs-print-bill tfoot td {
    border-bottom: none;
    border-top: 2px solid #111;
    font-weight: 700;
    padding-top: 0.75rem;
  }
  .hs-print-thanks {
    margin-top: 1.75rem;
    text-align: center;
    font-style: italic;
  }
</style>

<div class="hs-print-bill">
  <h1>HOTEL SIKKOLU</h1>
  <p class="subtitle">Bill Receipt</p>

  <div class="hs-print-meta">
    <div><strong>Bill No:</strong> <%= @bill.bill_number %></div>
    <div><strong>Table:</strong> <%= @bill.dining_table.name %></div>
    <div><strong>Opened:</strong> <%= @bill.opened_at.strftime("%d %b %Y, %I:%M %p") %></div>
    <div><strong>Paid:</strong> <%= @bill.paid_at&.strftime("%d %b %Y, %I:%M %p") || "—" %></div>
    <div><strong>Status:</strong> <%= @bill.status.titleize %></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Item</th>
        <th class="num">Qty</th>
        <th class="num">Rate (₹)</th>
        <th class="num">Amount (₹)</th>
      </tr>
    </thead>
    <tbody>
      <% @line_items.each do |line| %>
        <tr>
          <td><%= line.item_name %></td>
          <td class="num"><%= line.quantity %></td>
          <td class="num"><%= number_with_precision(line.unit_price, precision: 2) %></td>
          <td class="num"><%= number_with_precision(line.line_total, precision: 2) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3" class="num">TOTAL</td>
        <td class="num">₹ <%= number_with_precision(@bill.subtotal, precision: 2) %></td>
      </tr>
    </tfoot>
  </table>

  <p class="hs-print-thanks">Thank you for dining at Hotel Sikkolu!</p>
</div>
