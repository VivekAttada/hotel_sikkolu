<% content_for :title, "Bill #{@bill.bill_number} — Hotel Sikkolu" %>

<style>
  .hs-print-bill {
    width: 100%;
    margin: 0;
    font-family: "Courier New", Courier, monospace;
    font-size: 11px;
    line-height: 1.25;
  }
  .hs-print-bill h1 {
    margin: 0;
    font-size: 14px;
    text-align: center;
    letter-spacing: 0.04em;
  }
  .hs-print-bill .subtitle {
    margin: 2px 0 6px;
    text-align: center;
    font-size: 11px;
  }
  .hs-print-meta {
    margin-bottom: 6px;
    font-size: 10px;
    line-height: 1.3;
    border-top: 1px dashed #111;
    border-bottom: 1px dashed #111;
    padding: 4px 0;
  }
  .hs-print-bill table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10px;
  }
  .hs-print-bill th,
  .hs-print-bill td {
    padding: 3px 2px;
    border-bottom: 1px solid #ccc;
    text-align: left;
  }
  .hs-print-bill th {
    border-bottom: 1px solid #111;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .hs-print-bill .num {
    text-align: right;
    white-space: nowrap;
  }
  .hs-print-bill tfoot td {
    border-bottom: none;
    border-top: 1px solid #111;
    font-weight: 700;
    padding-top: 4px;
  }
  .hs-print-removals {
    margin-top: 8px;
    color: #b00020;
  }
  .hs-print-removals h2 {
    margin: 0 0 4px;
    font-size: 10px;
    color: #b00020;
  }
  .hs-print-removals table th,
  .hs-print-removals table td {
    border-bottom-color: #e0a0a8;
    color: #b00020;
  }
  .hs-print-removals table th {
    border-bottom-color: #b00020;
  }
  .hs-print-removal-reason {
    margin: 4px 0 0;
    font-size: 9px;
    font-style: italic;
    color: #b00020;
  }
  .hs-print-thanks {
    margin: 8px 0 0;
    text-align: center;
    font-size: 9px;
    font-style: italic;
  }
</style>

<div class="hs-print-bill">
  <h1>HOTEL SIKKOLU</h1>
  <p class="subtitle">Bill Receipt</p>

  <div class="hs-print-meta">
    <div><strong>Bill No:</strong> <%= @bill.bill_number %></div>
    <% if @bill.dining_table.takeaway? %>
      <div><strong>Type:</strong> Take Away</div>
    <% else %>
      <div><strong>Table:</strong> <%= @bill.dining_table.name %></div>
    <% end %>
    <div><strong>Opened:</strong> <%= @bill.opened_at.strftime("%d %b %Y, %I:%M %p") %></div>
    <div><strong>Paid:</strong> <%= @bill.paid_at&.strftime("%d %b %Y, %I:%M %p") || "—" %></div>
    <div><strong>Payment:</strong> <%= @bill.payment_method_label %></div>
    <div><strong>Status:</strong> <%= @bill.status.titleize %></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Item</th>
        <th class="num">Qty</th>
        <th class="num">Rate</th>
        <th class="num">Amt</th>
      </tr>
    </thead>
    <tbody>
      <% @line_items.each do |line| %>
        <tr>
          <td><%= line.item_name %></td>
          <td class="num"><%= line.quantity %></td>
          <td class="num"><%= number_with_precision(line.unit_price, precision: 2) %></td>
          <td class="num"><%= number_with_precision(line.line_total, precision: 2) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3" class="num">TOTAL</td>
        <td class="num">₹ <%= number_with_precision(@bill.subtotal, precision: 2) %></td>
      </tr>
    </tfoot>
  </table>

  <% if @bill_removals.any? %>
    <div class="hs-print-removals">
      <h2>Removed during settlement</h2>
      <table>
        <thead>
          <tr>
            <th>Item</th>
            <th class="num">Qty</th>
            <th class="num">Rate</th>
            <th class="num">Amt</th>
          </tr>
        </thead>
        <tbody>
          <% @bill_removals.each do |removal| %>
            <tr>
              <td><%= removal.item_name %></td>
              <td class="num"><%= removal.quantity %></td>
              <td class="num"><%= number_with_precision(removal.unit_price, precision: 2) %></td>
              <td class="num"><%= number_with_precision(removal.line_total, precision: 2) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% reason = @bill_removals.map(&:reason).compact_blank.uniq.join(" / ") %>
      <% if reason.present? %>
        <p class="hs-print-removal-reason"><strong>Reason:</strong> <%= reason %></p>
      <% end %>
    </div>
  <% end %>

  <p class="hs-print-thanks">Thank you for dining at Hotel Sikkolu!</p>
</div>
