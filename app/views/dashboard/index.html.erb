<div class="dashboard">
  <ul class="nav nav-tabs hs-mobile-tabs mb-3 mb-md-4" id="hotelTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <%= link_to grocery_path, class: "nav-link #{'active' if @active_tab == 'grocery'}", id: "grocery-tab" do %>
        <i class="bi bi-basket d-md-none me-1"></i>Grocery
      <% end %>
    </li>
    <li class="nav-item" role="presentation">
      <%= link_to checklist_path, class: "nav-link #{'active' if @active_tab == 'checklist'}", id: "checklist-tab" do %>
        <i class="bi bi-check2-square d-md-none me-1"></i>Checklist
      <% end %>
    </li>
    <li class="nav-item" role="presentation">
      <%= link_to quantities_path, class: "nav-link #{'active' if @active_tab == 'quantity'}", id: "quantity-tab" do %>
        <i class="bi bi-box-seam d-md-none me-1"></i>Quantities
      <% end %>
    </li>
    <li class="nav-item" role="presentation">
      <%= link_to bills_path, class: "nav-link #{'active' if @active_tab == 'bills'}", id: "bills-tab" do %>
        <i class="bi bi-receipt d-md-none me-1"></i>Bill Management
      <% end %>
    </li>
  </ul>

  <div class="tab-content" id="hotelTabsContent">
    <div class="tab-pane fade show active" role="tabpanel">
      <%= render "dashboard/#{@active_tab}_tab" %>
    </div>
  </div>
</div>
