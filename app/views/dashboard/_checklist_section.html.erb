<% checklist_view ||= "all" %>

<div class="checklist-section h-100 mb-0">
  <div class="table-responsive">
    <table class="table hs-table align-middle mb-0">
      <thead>
        <tr>
          <th colspan="2">
            <div class="d-flex justify-content-between align-items-center gap-2">
              <span><%= frequency.titleize %></span>
              <span class="checklist-section-count fw-normal text-uppercase">
                <%= entries.count { |e| e.checked } %> / <%= entries.size %> done
              </span>
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <% if entries.any? %>
          <% entries.each do |entry| %>
            <tr>
              <td class="p-0">
                <%= form_with url: checklist_entry_path(entry), method: :patch, class: "hs-checklist-item mb-0" do %>
                  <%= hidden_field_tag :checklist_view, checklist_view %>
                  <label class="hs-checklist-row" for="checklist_entry_<%= entry.id %>">
                    <%= check_box_tag :checked, "1", entry.checked,
                          id: "checklist_entry_#{entry.id}",
                          class: "hs-checklist-checkbox",
                          onchange: "this.form.requestSubmit()" %>
                    <span class="hs-checklist-text <%= 'checked-item' if entry.checked %>">
                      <%= entry.checklist_task.title %>
                      <% if entry.checked_at %>
                        <small class="d-block text-hs-success">Checked at <%= entry.checked_at.strftime("%I:%M %p") %> on <%= @checklist_date.strftime("%d %b %Y") %></small>
                      <% elsif !entry.checked %>
                        <small class="d-block text-hs-muted">Pending for <%= @checklist_date.strftime("%d %b %Y") %></small>
                      <% end %>
                    </span>
                  </label>
                <% end %>
              </td>
              <td class="hs-checklist-photo-cell">
                <div class="hs-checklist-photo-actions">
                  <% if entry.photo.attached? %>
                    <%= link_to rails_blob_path(entry.photo, disposition: "inline"),
                          class: "hs-checklist-thumb-link",
                          target: "_blank",
                          rel: "noopener",
                          data: { turbo: false },
                          title: "View photo" do %>
                      <%= image_tag url_for(entry.photo), class: "hs-checklist-thumb", alt: "Photo for #{entry.checklist_task.title}" %>
                    <% end %>
                    <%= button_to destroy_checklist_entry_photo_path(entry),
                          method: :delete,
                          class: "btn btn-outline-danger btn-sm",
                          title: "Remove photo",
                          params: { checklist_view: checklist_view },
                          form: { data: { turbo_confirm: "Remove photo for #{entry.checklist_task.title}?" } } do %>
                      <i class="bi bi-x-lg"></i>
                    <% end %>
                  <% end %>

                  <%= form_with url: checklist_entry_photo_path(entry),
                        method: :post,
                        multipart: true,
                        class: "hs-checklist-camera-form mb-0" do %>
                    <%= hidden_field_tag :checklist_view, checklist_view %>
                    <%= file_field_tag :photo,
                          accept: "image/*",
                          capture: "environment",
                          id: "checklist_photo_#{entry.id}",
                          class: "hs-checklist-camera-input",
                          required: true,
                          onchange: "this.form.requestSubmit()" %>
                    <label for="checklist_photo_<%= entry.id %>" class="btn btn-hs-outline btn-sm hs-checklist-camera-btn" title="<%= entry.photo.attached? ? 'Retake photo' : 'Take photo' %>">
                      <i class="bi bi-camera<%= entry.photo.attached? ? '-fill' : '' %>"></i>
                      <span class="d-none d-sm-inline"><%= entry.photo.attached? ? "Retake" : "Camera" %></span>
                    </label>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="2" class="text-hs-muted">No tasks in this section.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
