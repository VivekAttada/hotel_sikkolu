<% if bills.any? %>
  <div class="table-responsive">
    <table class="table hs-table align-middle mb-0">
      <thead>
        <tr>
          <th>Bill</th>
          <th>Table</th>
          <th>Items</th>
          <th>Total</th>
          <th>Payment</th>
          <th>Cashier</th>
          <th>Paid at</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% bills.each do |bill| %>
          <tr>
            <td>
              <%= bill.bill_number %>
              <% if bill.guest_name.present? %>
                <div class="small text-hs-muted"><%= bill.guest_name %></div>
              <% end %>
            </td>
            <td><%= bill.dining_table.display_name %></td>
            <td><%= bill.item_count %></td>
            <td>₹ <%= number_with_precision(bill.total, precision: 2) %></td>
            <td>
              <%= bill.payment_method_label %>
              <% if bill.payment_method == "split" %>
                <div class="small text-hs-muted">
                  C <%= number_with_precision(bill.cash_amount, precision: 0) %>
                  · U <%= number_with_precision(bill.upi_amount, precision: 0) %>
                  · D <%= number_with_precision(bill.card_amount, precision: 0) %>
                </div>
              <% end %>
            </td>
            <td><%= bill.cashier_label || "—" %></td>
            <td><%= bill.paid_at&.strftime("%I:%M %p") %></td>
            <td class="text-end">
              <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                <%= link_to "PDF", bill_pdf_path(bill), class: "btn btn-hs-outline btn-sm", target: "_blank", rel: "noopener", data: { turbo: false } %>
                <%= link_to "Print", bill_print_path(bill), class: "btn btn-hs-outline btn-sm", target: "_blank", rel: "noopener", data: { turbo: false } %>
                <% if current_user.admin? && local_assigns.fetch(:allow_void, false) %>
                  <%= form_with url: void_bill_path(bill), method: :post, class: "d-inline", data: { controller: "void-bill", void_bill_number_value: bill.bill_number, action: "submit->void-bill#confirm" } do %>
                    <%= hidden_field_tag :void_reason, "" %>
                    <%= submit_tag "Void", class: "btn btn-outline-danger btn-sm" %>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-hs-muted small mb-0"><%= empty_message %></p>
<% end %>
