<div class="hs-card">
  <div class="hs-card-header">
    <div class="hs-toolbar">
      <div class="hs-toolbar-title">
        <h5>Take Away</h5>
        <small>Run multiple takeaway orders at once. Print KOT for one customer, then start a new order for the next.</small>
      </div>
      <div class="hs-toolbar-actions">
        <%= button_to takeaway_orders_path, method: :post, class: "btn btn-hs-gold btn-sm hs-action-btn" do %>
          <i class="bi bi-plus-lg"></i>
          <span>New order</span>
        <% end %>
        <% if @bill %>
          <%= link_to takeaway_path, class: "btn btn-hs-outline btn-sm hs-action-btn" do %>
            <i class="bi bi-list-ul"></i>
            <span>All orders</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="hs-card-body">
    <div class="hs-takeaway-orders mb-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h6 class="text-hs-gold mb-0">Open orders (<%= @active_takeaway_orders.size %>)</h6>
        <%= button_to takeaway_orders_path, method: :post, class: "btn btn-hs-outline btn-sm hs-action-btn" do %>
          <i class="bi bi-plus-lg"></i>
          <span>New order</span>
        <% end %>
      </div>

      <% if @active_takeaway_orders.any? %>
        <div class="hs-dining-grid">
          <% @active_takeaway_orders.each_with_index do |order, index| %>
            <% selected = @bill&.id == order.id %>
            <%= link_to takeaway_path(bill_id: order.id),
                  class: "hs-dining-table #{selected ? 'is-active' : 'is-free'}" do %>
              <span class="hs-dining-name">TA <%= @active_takeaway_orders.size - index %></span>
              <span class="hs-dining-status"><%= selected ? "Editing" : "Open" %></span>
              <span class="hs-dining-meta"><%= order.bill_number %></span>
              <span class="hs-dining-meta">₹ <%= number_with_precision(order.total, precision: 2) %></span>
              <span class="hs-dining-meta"><%= pluralize(order.item_count, "item") %></span>
              <% if order.pending_kot? %>
                <span class="hs-dining-meta text-hs-gold">KOT pending</span>
              <% elsif order.bill_line_items.any? { |line| line.kot_sent_quantity.to_i.positive? } %>
                <span class="hs-dining-meta">KOT sent</span>
              <% end %>
            <% end %>
          <% end %>

          <%= button_to takeaway_orders_path,
                method: :post,
                class: "hs-dining-table hs-takeaway-new-card",
                form: { class: "hs-takeaway-new-form" } do %>
            <span class="hs-dining-name">+</span>
            <span class="hs-dining-status">New order</span>
            <span class="hs-dining-meta">Start another takeaway</span>
          <% end %>
        </div>
      <% else %>
        <div class="hs-takeaway-empty text-center py-4">
          <p class="text-hs-muted mb-3">No open takeaway orders.</p>
          <%= button_to takeaway_orders_path, method: :post, class: "btn btn-hs-gold hs-action-btn" do %>
            <i class="bi bi-plus-lg"></i>
            <span>Create first order</span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @bill %>
      <hr class="hs-takeaway-divider mb-4">

      <%= form_with url: bill_guest_path(@bill), method: :patch, class: "hs-bill-date-filter mb-3" do %>
        <label class="hs-bill-date-label" for="guest_name">Guest</label>
        <%= text_field_tag :guest_name, @bill.guest_name, class: "form-control form-control-sm", id: "guest_name", placeholder: "Name" %>
        <%= telephone_field_tag :guest_phone, @bill.guest_phone, class: "form-control form-control-sm", placeholder: "Phone" %>
        <%= submit_tag "Save", class: "btn btn-hs-outline btn-sm hs-action-btn" %>
      <% end %>

      <div class="hs-toolbar mb-3">
        <div class="hs-toolbar-title">
          <h6 class="text-hs-gold mb-0">Order <%= @bill.bill_number %><% if @bill.latest_kot_number %> · KOT <%= @bill.latest_kot_number %><% end %></h6>
          <small>
            Opened <%= @bill.opened_at.strftime("%I:%M %p") %> ·
            <span class="text-hs-gold"><%= @bill.status_label %></span>
            <% if @bill.guest_name.present? || @bill.guest_phone.present? %>
              · <%= [ @bill.guest_name, @bill.guest_phone ].compact.join(" · ") %>
            <% end %>
          </small>
        </div>
        <div class="hs-toolbar-actions">
          <%= button_to takeaway_orders_path, method: :post, class: "btn btn-hs-gold btn-sm hs-action-btn" do %>
            <i class="bi bi-plus-lg"></i>
            <span>New order</span>
          <% end %>
          <%= button_to delete_bill_path(@bill), method: :delete, class: "btn btn-outline-danger btn-sm hs-action-btn", form: { data: { turbo_confirm: "Cancel this takeaway bill?" } } do %>
            <i class="bi bi-trash"></i>
            <span>Delete</span>
          <% end %>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-7">
          <h6 class="text-hs-gold mb-3">Menu</h6>
          <% if @menu_categories.any? %>
            <%= render "bills/menu",
                  categories: @menu_categories,
                  items_by_category: @menu_items_by_category,
                  selected_category: @selected_menu_category,
                  category_path: ->(category) { takeaway_path(bill_id: @bill.id, menu_category: category) },
                  add_path: add_bill_item_path(@dining_table),
                  extra_params: { bill_id: @bill.id } %>
          <% else %>
            <p class="text-hs-muted">No menu items available.</p>
          <% end %>
        </div>

        <div class="col-lg-5">
          <h6 class="text-hs-gold mb-3">Current order</h6>
          <% if @line_items.any? %>
            <div class="table-responsive mb-3">
              <table class="table hs-table align-middle">
                <thead>
                  <tr>
                    <th>Item</th>
                    <th>Qty / Note</th>
                    <th>Amount</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% @line_items.each do |line| %>
                    <tr>
                      <td>
                        <div><%= line.item_name %></div>
                        <small class="text-hs-muted">₹ <%= number_with_precision(line.unit_price, precision: 2) %> each</small>
                        <% if line.kot_sent_quantity.to_i.positive? %>
                          <small class="text-hs-muted d-block">KOT sent × <%= line.kot_sent_quantity %><%= " · new × #{line.pending_kot_quantity}" if line.kot_pending? %></small>
                        <% end %>
                      </td>
                      <td>
                        <%= render "bills/order_line_controls", bill: @bill, line: line, menu_category: @selected_menu_category %>
                      </td>
                      <td>₹ <%= number_with_precision(line.line_total, precision: 2) %></td>
                      <td class="text-end">
                        <%= button_to "×",
                              remove_bill_item_path(@bill, line),
                              method: :delete,
                              params: { menu_category: @selected_menu_category },
                              class: "btn btn-outline-danger btn-sm",
                              form: { data: { turbo_confirm: "Remove #{line.item_name}?" } } %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <div class="mb-3">
              <%= render "bills/totals", bill: @bill %>
            </div>

            <%= render "bills/bill_checkout", bill: @bill, modal_id: "settleTakeawayModal", title: "Settle and Save" %>

            <%= button_to takeaway_orders_path, method: :post, class: "btn btn-hs-gold w-100 mb-2" do %>
              <i class="bi bi-plus-lg"></i>
              New takeaway order
            <% end %>

            <%= form_with url: delete_bill_path(@bill), method: :delete do %>
              <% if @bill.kot_sent? %>
                <%= text_field_tag :cancel_reason, nil, class: "form-control form-control-sm mb-2", required: true, placeholder: "Reason to cancel after KOT" %>
              <% end %>
              <%= submit_tag "Cancel bill", class: "btn btn-outline-danger w-100", data: { turbo_confirm: "Cancel this takeaway bill?" } %>
            <% end %>
          <% else %>
            <p class="text-hs-muted mb-3">No items yet. Add food from the menu.</p>
            <%= button_to takeaway_orders_path, method: :post, class: "btn btn-hs-outline w-100" do %>
              <i class="bi bi-plus-lg"></i>
              Start another order instead
            <% end %>
          <% end %>
        </div>
      </div>
    <% elsif @active_takeaway_orders.any? %>
      <p class="text-hs-muted mb-0">Tap an open order above to add items, or create a new order for the next customer.</p>
    <% end %>
  </div>
</div>
