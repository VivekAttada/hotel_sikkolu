<div class="hs-card">
  <div class="hs-card-header">
    <div class="hs-toolbar">
      <div class="hs-toolbar-title">
        <h5>Grocery Inventory</h5>
        <% if @last_grocery_import %>
          <small>Last imported: <%= @last_grocery_import.strftime("%d %b %Y, %I:%M %p") %></small>
        <% else %>
          <small>Download the sample sheet, fill it, then upload — or add items manually</small>
        <% end %>
      </div>

      <div class="hs-toolbar-actions">
        <%= link_to grocery_sample_path, class: "btn btn-hs-outline btn-sm hs-action-btn", data: { turbo: false } do %>
          <i class="bi bi-file-earmark-arrow-down"></i>
          <span>Sample Sheet</span>
        <% end %>

        <%= form_with url: import_groceries_path, method: :post, multipart: true, class: "hs-upload-form" do |f| %>
          <label class="hs-file-picker">
            <i class="bi bi-file-earmark-spreadsheet"></i>
            <span class="hs-file-label" data-default="Choose Excel file">Choose Excel file</span>
            <%= f.file_field :file,
                  accept: ".xlsx,.xls,.csv",
                  required: true,
                  class: "hs-file-input",
                  onchange: "this.closest('.hs-file-picker').querySelector('.hs-file-label').textContent = this.files[0] ? this.files[0].name : this.closest('.hs-file-picker').querySelector('.hs-file-label').dataset.default" %>
          </label>
          <%= f.submit "Upload", class: "btn btn-hs-gold btn-sm hs-action-btn" %>
        <% end %>

        <% if @grocery_has_items %>
          <%= link_to export_grocery_path, class: "btn btn-hs-outline btn-sm hs-action-btn", data: { turbo: false } do %>
            <i class="bi bi-download"></i>
            <span>Export</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="hs-card-body">
    <%= form_with url: grocery_path, method: :get, class: "hs-bill-date-filter mb-4" do %>
      <label class="hs-bill-date-label" for="grocery_q">Search item</label>
      <%= text_field_tag :grocery_q, @grocery_q, class: "form-control form-control-sm", id: "grocery_q", placeholder: "Item name" %>
      <%= submit_tag "Search", class: "btn btn-hs-gold btn-sm hs-action-btn" %>
      <% if @grocery_q.present? %>
        <%= link_to "Clear", grocery_path, class: "btn btn-hs-outline btn-sm hs-action-btn" %>
      <% end %>
    <% end %>

    <div class="hs-grocery-add mb-4">
      <h6 class="text-hs-gold mb-3">Add grocery item</h6>
      <%= form_with model: @new_grocery_item, url: groceries_path, method: :post, class: "hs-grocery-form" do |f| %>
        <div class="row g-2 align-items-end">
          <div class="col-6 col-md-1">
            <%= f.label :serial_no, "Sl No.", class: "form-label small mb-1" %>
            <%= f.number_field :serial_no, class: "form-control form-control-sm", min: 1, placeholder: "Auto" %>
          </div>
          <div class="col-12 col-md-3">
            <%= f.label :item_name, "Item Name", class: "form-label small mb-1" %>
            <%= f.text_field :item_name, class: "form-control form-control-sm", required: true, placeholder: "Item name" %>
          </div>
          <div class="col-6 col-md-2">
            <%= f.label :old_stock, "Old Stock", class: "form-label small mb-1" %>
            <%= f.number_field :old_stock, class: "form-control form-control-sm", step: 0.001, value: 0 %>
          </div>
          <div class="col-6 col-md-2">
            <%= f.label :new_stock_added, "New Stock", class: "form-label small mb-1" %>
            <%= f.number_field :new_stock_added, class: "form-control form-control-sm", step: 0.001, value: 0 %>
          </div>
          <div class="col-6 col-md-2">
            <%= f.label :unit, "Qty (unit)", class: "form-label small mb-1" %>
            <%= f.text_field :unit, class: "form-control form-control-sm", placeholder: "Kg / Pcs" %>
          </div>
          <div class="col-6 col-md-2">
            <%= f.submit "Add", class: "btn btn-hs-gold btn-sm w-100" %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @grocery_items.any? %>
      <div class="d-none d-md-block table-responsive">
        <table class="table hs-table align-middle">
          <thead>
            <tr>
              <th>Sl No.</th>
              <th>Item Name</th>
              <th>Old Stock</th>
              <th>New Stock Added</th>
              <th>Qty</th>
              <th>Total Updated Stock</th>
              <th>Issued</th>
              <th>Total</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @grocery_items.each_with_index do |item, index| %>
              <% if @editing_grocery&.id == item.id %>
                <tr class="hs-grocery-edit-row">
                  <td colspan="9">
                    <%= form_with model: item, url: grocery_item_path(item), method: :patch, class: "hs-grocery-form" do |f| %>
                      <div class="row g-2 align-items-end">
                        <div class="col-md-1">
                          <%= f.label :serial_no, "Sl No.", class: "form-label small mb-1" %>
                          <%= f.number_field :serial_no, class: "form-control form-control-sm", min: 1 %>
                        </div>
                        <div class="col-md-2">
                          <%= f.label :item_name, "Item Name", class: "form-label small mb-1" %>
                          <%= f.text_field :item_name, class: "form-control form-control-sm", required: true %>
                        </div>
                        <div class="col-md-1">
                          <%= f.label :old_stock, "Old Stock", class: "form-label small mb-1" %>
                          <%= f.number_field :old_stock, class: "form-control form-control-sm", step: 0.001 %>
                        </div>
                        <div class="col-md-1">
                          <%= f.label :new_stock_added, "New Stock", class: "form-label small mb-1" %>
                          <%= f.number_field :new_stock_added, class: "form-control form-control-sm", step: 0.001 %>
                        </div>
                        <div class="col-md-1">
                          <%= f.label :unit, "Unit", class: "form-label small mb-1" %>
                          <%= f.text_field :unit, class: "form-control form-control-sm" %>
                        </div>
                        <div class="col-md-2">
                          <%= f.label :issued, "Issued (total)", class: "form-label small mb-1" %>
                          <%= f.number_field :issued, class: "form-control form-control-sm", step: 0.001, min: 0 %>
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                          <%= f.submit "Save", class: "btn btn-hs-gold btn-sm" %>
                          <%= link_to "Cancel", grocery_path(grocery_q: @grocery_q.presence), class: "btn btn-hs-outline btn-sm" %>
                        </div>
                      </div>
                    <% end %>
                  </td>
                </tr>
              <% else %>
                <tr>
                  <td><%= item.serial_no.presence || (index + 1) %></td>
                  <td class="fw-semibold"><%= item.item_name %></td>
                  <td><%= number_with_precision(item.old_stock, precision: 3, strip_insignificant_zeros: true) %></td>
                  <td><%= number_with_precision(item.new_stock_added, precision: 3, strip_insignificant_zeros: true) %></td>
                  <td><%= item.unit %></td>
                  <td>
                    <%= number_with_precision(item.quantity, precision: 3, strip_insignificant_zeros: true) %>
                    <%= item.unit %>
                  </td>
                  <td>
                    <div class="d-flex flex-column gap-1">
                      <span>
                        <%= number_with_precision(item.issued, precision: 3, strip_insignificant_zeros: true) %>
                        <%= item.unit %>
                      </span>
                      <%= form_with url: issue_grocery_item_path(item), method: :post, class: "hs-issue-form d-flex gap-1 align-items-center" do %>
                        <%= number_field_tag :issue_qty, nil, class: "form-control form-control-sm", step: 0.001, min: 0.001, placeholder: "Issue", style: "width: 5.5rem", required: true %>
                        <%= submit_tag "Issue", class: "btn btn-hs-outline btn-sm" %>
                      <% end %>
                    </div>
                  </td>
                  <td class="fw-semibold text-hs-gold">
                    <%= number_with_precision(item.available_total, precision: 3, strip_insignificant_zeros: true) %>
                    <%= item.unit %>
                  </td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                      <%= link_to "Edit", grocery_path(edit_grocery: item.id, grocery_q: @grocery_q.presence), class: "btn btn-hs-outline btn-sm" %>
                      <%= button_to "Delete", grocery_item_path(item), method: :delete, class: "btn btn-outline-danger btn-sm", form: { data: { turbo_confirm: "Delete #{item.item_name}?" } } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="d-md-none hs-mobile-cards">
        <% @grocery_items.each_with_index do |item, index| %>
          <div class="hs-mobile-card">
            <% if @editing_grocery&.id == item.id %>
              <%= form_with model: item, url: grocery_item_path(item), method: :patch, class: "hs-grocery-form" do |f| %>
                <div class="row g-2">
                  <div class="col-4"><%= f.number_field :serial_no, class: "form-control form-control-sm", placeholder: "Sl No." %></div>
                  <div class="col-8"><%= f.text_field :item_name, class: "form-control form-control-sm", required: true, placeholder: "Item name" %></div>
                  <div class="col-6"><%= f.number_field :old_stock, class: "form-control form-control-sm", step: 0.001, placeholder: "Old stock" %></div>
                  <div class="col-6"><%= f.number_field :new_stock_added, class: "form-control form-control-sm", step: 0.001, placeholder: "New stock" %></div>
                  <div class="col-6"><%= f.text_field :unit, class: "form-control form-control-sm", placeholder: "Unit" %></div>
                  <div class="col-6"><%= f.number_field :issued, class: "form-control form-control-sm", step: 0.001, min: 0, placeholder: "Issued" %></div>
                  <div class="col-6"><%= f.submit "Save", class: "btn btn-hs-gold btn-sm w-100" %></div>
                  <div class="col-6"><%= link_to "Cancel", grocery_path(grocery_q: @grocery_q.presence), class: "btn btn-hs-outline btn-sm w-100" %></div>
                </div>
              <% end %>
            <% else %>
              <div class="hs-mobile-card-header">
                <span class="hs-mobile-card-index"><%= item.serial_no.presence || (index + 1) %></span>
                <span class="hs-mobile-card-title"><%= item.item_name %></span>
              </div>
              <dl class="hs-mobile-dl">
                <div><dt>Old Stock</dt><dd><%= number_with_precision(item.old_stock, precision: 3, strip_insignificant_zeros: true) %></dd></div>
                <div><dt>New Stock</dt><dd><%= number_with_precision(item.new_stock_added, precision: 3, strip_insignificant_zeros: true) %></dd></div>
                <div><dt>Qty</dt><dd><%= item.unit.presence || "—" %></dd></div>
                <div>
                  <dt>Total Updated</dt>
                  <dd>
                    <%= number_with_precision(item.quantity, precision: 3, strip_insignificant_zeros: true) %>
                    <%= item.unit %>
                  </dd>
                </div>
                <div>
                  <dt>Issued</dt>
                  <dd>
                    <%= number_with_precision(item.issued, precision: 3, strip_insignificant_zeros: true) %>
                    <%= item.unit %>
                  </dd>
                </div>
                <div>
                  <dt>Total</dt>
                  <dd class="text-hs-gold fw-semibold">
                    <%= number_with_precision(item.available_total, precision: 3, strip_insignificant_zeros: true) %>
                    <%= item.unit %>
                  </dd>
                </div>
              </dl>
              <%= form_with url: issue_grocery_item_path(item), method: :post, class: "hs-issue-form d-flex gap-2 mt-2" do %>
                <%= number_field_tag :issue_qty, nil, class: "form-control form-control-sm", step: 0.001, min: 0.001, placeholder: "Qty to issue", required: true %>
                <%= submit_tag "Issue", class: "btn btn-hs-outline btn-sm" %>
              <% end %>
              <div class="d-flex gap-2 mt-2">
                <%= link_to "Edit", grocery_path(edit_grocery: item.id, grocery_q: @grocery_q.presence), class: "btn btn-hs-outline btn-sm flex-fill" %>
                <%= button_to "Delete", grocery_item_path(item), method: :delete, class: "btn btn-outline-danger btn-sm flex-fill", form: { data: { turbo_confirm: "Delete #{item.item_name}?" }, class: "flex-fill" } %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <p class="text-end text-hs-muted small mb-0 mt-3">
        <% if @grocery_q.present? %>
          Showing <%= @grocery_items.size %> result<%= "s" unless @grocery_items.size == 1 %> for “<%= @grocery_q %>”
        <% else %>
          Total items: <%= @grocery_items.size %>
        <% end %>
      </p>
    <% else %>
      <div class="text-center py-4 text-hs-muted">
        <% if @grocery_q.present? %>
          <p class="mb-1">No items found for “<%= @grocery_q %>”.</p>
          <p class="small mb-0"><%= link_to "Clear search", grocery_path, class: "text-hs-gold" %></p>
        <% else %>
          <p class="mb-1">No grocery data yet.</p>
          <p class="small mb-0">Add an item above, or download the sample sheet and upload.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
