<div class="hs-card">
  <div class="hs-card-header">
    <div class="hs-toolbar">
      <div class="hs-toolbar-title">
        <h5>Bill Management</h5>
        <small>Tap a table to take an order. To split a table for two groups, open an empty table and tap Split beside All tables. After both bills are paid, the extra table goes away.</small>
      </div>
      <% if can_view_paid_bills? %>
        <div class="hs-toolbar-actions">
          <%= link_to paid_bills_path, class: "btn btn-hs-gold btn-sm hs-action-btn" do %>
            <i class="bi bi-journal-check"></i>
            <span>Paid bills</span>
          <% end %>
          <% if current_user.admin? %>
            <%= link_to payments_path(payment_date: @bill_date), class: "btn btn-hs-gold btn-sm hs-action-btn" do %>
              <i class="bi bi-graph-up"></i>
              <span>View payments</span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="hs-card-body">
    <h6 class="text-hs-gold mb-3">Dining tables</h6>
    <div class="hs-dining-grid mb-4">
      <% @dining_tables.each do |table| %>
        <% bill = table.active_bill %>
        <div class="hs-dining-card <%= 'is-split' if table.split_child? %>">
          <% occupied = bill.present? && bill.item_count.to_i.positive? %>
          <%= link_to bill_path(table), class: "hs-dining-table #{occupied ? 'is-occupied' : 'is-empty'}" do %>
            <span class="hs-dining-name"><%= table.name %></span>
            <% if bill %>
              <span class="hs-dining-status">Bill <%= bill.bill_number %></span>
              <span class="hs-dining-meta">₹ <%= number_with_precision(bill.total, precision: 2) %></span>
              <span class="hs-dining-meta"><%= pluralize(bill.item_count, "item") %></span>
            <% else %>
              <span class="hs-dining-status">Free</span>
              <span class="hs-dining-meta">Tap to open bill</span>
            <% end %>
            <% if bill&.due? %>
              <span class="hs-dining-meta text-danger">Due</span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if can_view_paid_bills? %>
      <div class="row g-4">
        <% if current_user.admin? %>
          <div class="col-12">
            <h6 class="text-hs-gold mb-3">
              Deleted / cancelled — <%= @bill_date == Bill.business_date_for ? "Today" : @bill_date.strftime("%d %b %Y") %>
            </h6>
            <%= render "dashboard/deleted_bills_section" %>
          </div>
        <% end %>
        <% if @due_bills.any? %>
          <div class="col-12">
            <h6 class="text-hs-gold mb-3">Due bills</h6>
            <%= render "dashboard/bills_history", bills: @due_bills, empty_message: "No due bills." %>
          </div>
        <% end %>
        <% if current_user.admin? && @voided_bills.any? %>
          <div class="col-12">
            <h6 class="text-hs-gold mb-3">Voided bills (kept in books)</h6>
            <div class="table-responsive">
              <table class="table hs-table align-middle mb-0">
                <thead>
                  <tr>
                    <th>Bill</th>
                    <th>Total</th>
                    <th>Reason</th>
                    <th>By</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% @voided_bills.each do |bill| %>
                    <tr>
                      <td><%= bill.bill_number %></td>
                      <td>₹ <%= number_with_precision(bill.total, precision: 2) %></td>
                      <td><%= bill.void_reason %></td>
                      <td><%= bill.voided_by&.display_name %></td>
                      <td>
                        <%= button_to "Restore", restore_bill_path(bill), method: :post, class: "btn btn-hs-outline btn-sm", form: { data: { turbo_confirm: "Restore #{bill.bill_number} to collection?" } } %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
